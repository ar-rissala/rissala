# =============================================================================
# RISSALA.NET — CONFIGURATION DJANGO & RAILWAY (.env.example)
# =============================================================================

# --- Core Django Settings ---
DJANGO_SECRET_KEY=change-me-in-production-with-a-50-char-cryptographic-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.railway.app,rissala.net,www.rissala.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://rissala.net,https://www.rissala.net
SITE_URL=https://rissala.net

# --- Database (PostgreSQL on Railway) ---
# If omitted in local development, falls back to SQLite (db.sqlite3).
DATABASE_URL=postgresql://postgres:password@localhost:5432/rissala
DB_CONN_MAX_AGE=600

# --- Security & Proxy Headers (Railway HTTPS) ---
SECURE_SSL_REDIRECT=True

# --- Object Storage S3 / Cloudflare R2 / AWS S3 (Optional, for large EPUB/PDF/Media) ---
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=rissala-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Video Streaming Signing Key (Courses / Parcours) ---
VIDEO_SIGNING_SECRET=change-me-video-signing-secret
VIDEO_STREAM_BASE_URL=https://stream.rissala.net

# --- Email & Brevo Newsletter Integration ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Rissala <noreply@rissala.net>
BREVO_API_KEY=
BREVO_LIST_ID=2

# --- Celery & Redis (Optional, for async newsletter campaigns) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS for React Native Mobile App ---
CORS_ALLOWED_ORIGINS=https://rissala.net
CORS_ALLOW_ALL_ORIGINS=False

