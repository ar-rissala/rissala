# ─── Database ───────────────────────────────────────────
DB_NAME=rissala_db
DB_USER=rissala_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ─── Django ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Email ───────────────────────────────────────────────
# En développement, laisser EMAIL_BACKEND vide pour utiliser la console.
# En production, remplir les champs SMTP ci-dessous.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@rissala.net
EMAIL_HOST_PASSWORD=changeme
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Rissala <noreply@rissala.net>

# ─── Frontend ────────────────────────────────────────────
# URL du frontend Next.js (pour CORS et les liens dans les emails)
FRONTEND_URL=http://localhost:3000
